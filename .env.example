# Server
NODE_ENV=development
PORT=4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/Tuition_SaaS
MONGODB_DB_NAME=Tuition_SaaS
# Optional comma-separated DNS servers for mongodb+srv:// SRV lookup if local DNS refuses SRV queries
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Institute Branding
INSTITUTE_NAME=Bright Future Institute
APP_NAME=EduFlow

# Mail (@nestjs/mail & Resend)
# Transport mode: resend | smtp | log | file
MAIL_TRANSPORT=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="EduFlow <onboarding@resend.dev>"
MAIL_FROM="EduFlow <onboarding@resend.dev>"

# SMTP fallback (if MAIL_TRANSPORT=smtp)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_DIRECTORY=var/mail

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Admin Default Credentials
ADMIN_DEFAULT_NAME=Admin
ADMIN_DEFAULT_EMAIL=admin@gmail.com
ADMIN_DEFAULT_PASSWORD=Admin@123
AUTH_ALLOW_REGISTRATION=true

# NestJS Observe (optional)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
